{
  "rules": {
    "portal": {
      ".read": "auth != null && root.child('portal/users/' + auth.uid + '/role').val() === 'admin'",
      ".write": "auth != null && root.child('portal/users/' + auth.uid + '/role').val() === 'admin'",
      "users": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid"
        }
      },
      "entries": {
